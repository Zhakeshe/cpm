# CRM
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=
COOKIE_SECURE=false

# Live WhatsApp path. Keep wazzup until Meta verification; set meta to restore Cloud API.
# Do not delete WHATSAPP_* keys when parking — they stay for the switch-back.
WHATSAPP_TRANSPORT=wazzup

# WhatsApp Cloud API (Direct WABA, parked) — never expose to frontend, never commit .env
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Wazzup (temporary WhatsApp until Meta verification) — never commit real keys
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=

# Public WhatsApp number for /w/{instagram|tiktok|...} click-to-chat (digits only)
WHATSAPP_PUBLIC_NUMBER=

# Meta Lead Ads (можно переиспользовать токен WABA)
META_LEADS_ACCESS_TOKEN=
META_LEADS_VERIFY_TOKEN=

# Ограничение частоты запросов к API на пользователя в минуту
API_RATE_LIMIT=600

# Zadarma server-side API credentials
ZADARMA_USER_KEY=
ZADARMA_SECRET=
SIP_CORPORATE_NUMBER=+77172696753
# Default documented API format; kz-domestic explicitly sends KZ destinations as 8...
# Domestic format is operator-requested and requires live provider verification.
ZADARMA_DESTINATION_FORMAT=international
# Explicit logical CRM extension -> real SIP authentication login.
# Optional password is needed ONLY for the authenticated browser softphone.
# Optional pbxExtension is a verified Zadarma PBX routing ID (not the CRM extension).
# Example structure: {"101":{"username":"REAL_SIP_LOGIN","password":"SECRET"}}
SIP_ACCOUNTS_JSON=
# One-time setup: exact database user ID -> logical CRM extension, no automatic allocation.
SIP_USER_MAPPING_JSON=
# Browser phone: zadarma-widget (official widget, no SIP password required) or jssip.
SIP_BROWSER_MODE=jssip
# JsSIP WebSocket endpoint: leave empty for native SIP phones/MicroSIP.
# Set only a provider-confirmed endpoint for your SIP/PBX account type.
SIP_WS_URL=
SIP_DOMAIN=sip.zadarma.com
# Optional generic (non-Zadarma) webhook authentication; reject if missing.
SIP_WEBHOOK_SECRET=

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crm-media
S3_REGION=us-east-1

# Mail (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

BACKUP_RETENTION_DAYS=14
