# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kern_scrimmage?schema=public"

# Password for /admin (required)
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (use a long random string)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"

# Public site URL (used in sitemap, Open Graph, robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional URL prefix when the app is hosted under a path (production: /scrimmage)
# NEXT_PUBLIC_BASE_PATH="/scrimmage"

# Organizer contacts (shown in footer)
