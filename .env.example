# CRM
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false

# Live WhatsApp path. Keep wazzup until Meta verification; set meta to restore Cloud API.
# Do not delete WHATSAPP_* keys when parking — they stay for the switch-back.
WHATSAPP_TRANSPORT=wazzup

# WhatsApp Cloud API (Direct WABA, parked) — never expose to frontend, never commit .env
WHATSAPP_VERIFY_TOKEN=quantum_waba_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Wazzup (temporary WhatsApp until Meta verification) — never commit real keys
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=

# Public WhatsApp number for /w/{instagram|tiktok|...} click-to-chat (digits only)
WHATSAPP_PUBLIC_NUMBER=

# Meta Lead Ads (можно переиспользовать токен WABA)
META_LEADS_ACCESS_TOKEN=
META_LEADS_VERIFY_TOKEN=

# Ограничение частоты запросов к API на пользователя в минуту
API_RATE_LIMIT=600

# SIP / virtual PBX
SIP_WEBHOOK_SECRET=change-sip-secret
SIP_ORIGINATE_URL=
SIP_API_TOKEN=
SIP_CORPORATE_NUMBER=
SIP_WS_URL=
SIP_DOMAIN=

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=crm-media
S3_REGION=us-east-1

# Mail (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

BACKUP_RETENTION_DAYS=14
