{
	email admin@quantum.ushqn.com
	# Default Caddy redirects http://IP → https://IP, which has no certificate.
	auto_https disable_redirects
}

http://31.77.12.47 {
	redir https://quantum.ushqn.com{uri} permanent
}

http://quantum.ushqn.com {
	redir https://quantum.ushqn.com{uri} permanent
}

quantum.ushqn.com {
	encode gzip
	reverse_proxy app:3000 {
		flush_interval -1
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}
